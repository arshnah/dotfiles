$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* To enable blur please make sure alpha is greater than 0 */
@define-color bar-bg rgba(0, 0, 0, 0.1);

@define-color main-bg #1a1a1a;
@define-color main-fg #e6e6e6;

@define-color wb-act-bg #999999;
@define-color wb-act-fg #111111;

@define-color wb-hvr-bg #555555;
@define-color wb-hvr-fg #ffffff;
