{
    // "sunny" layout — restyled to match an Omarchy-style orange-on-black
    // terminal aesthetic per user reference screenshot (chevron-separated
    // segments, boxed logo/active-workspace, monospace, no rounding).
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "height": 26,
    "spacing": 0,
    "margin-left": 0,
    "margin-right": 0,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": [
        "custom/hyde-menu",
        "custom/sep-left",
        "idle_inhibitor",
        "custom/sep-left",
        "mpris",
        "custom/sep-left",
        "network",
        "bluetooth",
        "tray"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "cpu",
        "backlight",
        "clock",
        "custom/power"
    ],
    // includes.json gets auto-regenerated (wiping edits there), so per-module
    // overrides live here instead.
    "custom/hyde-menu": {
        "format": "OMARCHY",
        "tooltip-format": "Right-click for more HyDE options"
    },
    "custom/sep-left": {
        "exec": "echo »",
        "interval": "once",
        "tooltip": false
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "idle active",
            "deactivated": "idle inactive"
        },
        "tooltip": false
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "persistent-workspaces": {
            "*": 9
        }
    },
    "hyprland/window": {
        "format": "{class}",
        "separate-outputs": true,
        "max-length": 24,
        "icon": true,
        "icon-size": 16
    },
    "mpris": {
        "format": "♪ {title}",
        "format-paused": "♪ {title}",
        "max-length": 22
    },
    "tray": {
        "icon-size": 12,
        "spacing": 8
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "tooltip-format": "{controller_alias}\t{controller_address}"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 10,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 10,
        "format": " {used:0.1f}GB",
        "max-length": 12,
        "on-click": "kitty -e btop"
    },
    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "hyde-shell brightnesscontrol i 5",
        "on-scroll-down": "hyde-shell brightnesscontrol d 5",
        "tooltip": false
    },
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " mute",
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-right": "hyde-shell volumecontrol -o m",
        "scroll-step": 5,
        "max-volume": 150
    },
    "pulseaudio#microphone": {
        "format": " {volume}%",
        "format-muted": " mute",
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-right": "hyde-shell volumecontrol -i m",
        "scroll-step": 5,
        "max-volume": 150
    },
    "battery": {
        "interval": 5,
        "states": {
            "good": 99,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "interval": 2,
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " eth",
        "format-disconnected": "",
        "tooltip-format": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },
    "clock": {
        "format": " {:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "interval": 10
    },
    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Logout menu",
        "on-click": "hyde-shell logoutlaunch 1",
        "menu": "on-click-right",
        "menu-file": "${HYDE_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/power.xml"
    }
}
