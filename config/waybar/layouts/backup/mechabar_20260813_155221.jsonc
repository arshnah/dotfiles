{
    // mechabar (https://github.com/sejjy/mechabar) — ships its own complete
    // set of modules/scripts, copied self-contained into mechabar-assets/
    // so it never touches HyDE's shared modules/includes.json namespace.
    "mode": "dock",
    "position": "top",
    "layer": "top",
    "output": ["*"],
    "width": 0,
    "height": 0,
    "margin": 0,
    "spacing": 0,
    "reload_style_on_change": true,

    // NOTE: waybar does not expand $XDG_CONFIG_HOME (or any env var) in
    // "include" glob patterns -- HyDE's own layouts only get away with using
    // it because their real modules come through includes.json (an already
    // fully-resolved absolute path list regenerated by waybar.py). Confirmed
    // via journal: "[warning] Unable to find resource file: $XDG_CONFIG_HOME/...".
    // So these must be literal absolute paths.
    "include": [
        "/home/arsh/.config/waybar/mechabar-assets/modules/custom/*.jsonc",
        "/home/arsh/.config/waybar/mechabar-assets/modules/hyprland/*.jsonc",
        "/home/arsh/.config/waybar/mechabar-assets/modules/*.jsonc"
    ],

    "modules-left": [
        "custom/user",

        "custom/left#bg-1",
        "hyprland/workspaces",
        "custom/right#bg-1",

        "hyprland/window"
    ],

    "modules-center": [
        "custom/left#bg-1",
        "clock#time",
        "custom/right#bg-1"
    ],

    "modules-right": [
        "custom/left#bg-1",
        "temperature",

        "custom/left#bg-2",
        "memory",

        "custom/left#bg-3",
        "cpu",
        "custom/left#inverse",

        "custom/left#accent",
        "custom/distro",
        "custom/right#accent",

        "custom/right#inverse",
        "idle_inhibitor",
        "clock#date",
        "custom/right#bg-3",

        "network",
        "bluetooth",
        "custom/update",
        "custom/right#bg-1",

        "mpris",

        "custom/left#bg-1",
        "group/pulseaudio",

        "custom/left#bg-2",
        "backlight",

        "custom/left#bg-3",
        "battery",
        "custom/left#inverse",

        "custom/power"
    ]
}
