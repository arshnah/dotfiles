{
    // "hancore-gruvbox" — adapted from HANCORE-linux/waybar-themes config/V2.
    // Original was Omarchy-based (custom/omarchy, custom/update, custom/voxtype,
    // idle/notification-silencing/screenrecording indicators, wttrbar weather,
    // pacman-updates AUR module) — those Omarchy/AUR-only modules were dropped
    // or swapped for HyDE equivalents (custom/hyde-menu, custom/updates,
    // custom/power). Static Gruvbox palette kept hardcoded for visual fidelity.
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "height": 24,
    "margin-top": 0,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": [
        "custom/hyde-menu",
        "clock",
        "idle_inhibitor",
        "hyprland/workspaces",
        "custom/updates",
        "mpris"
    ],
    "modules-center": ["hyprland/window"],
    "modules-right": [
        "tray",
        "backlight",
        "bluetooth",
        "pulseaudio",
        "pulseaudio#microphone",
        "network",
        "memory",
        "battery",
        "cpu",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "on-click": "activate",
        "disable-scroll": true,
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{title} - {class}",
        "max-length": 65,
        "separate-outputs": true
    },
    "cpu": {
        "interval": 2,
        "format": "{usage}% 󰍛",
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "{percentage}%  ",
        "on-click": "kitty -e btop"
    },
    "clock": {
        "format": " {:%H:%M %a}",
        "format-alt": " {:%d/%m/%Y  %H:%M:%S}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾫"
        }
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "on-click": "kitty -e nmtui"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "",
        "tooltip-format": "Devices connected: {num_connections}"
    },
    "backlight": {
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
        "on-scroll-up": "hyde-shell brightnesscontrol i 5",
        "on-scroll-down": "hyde-shell brightnesscontrol d 5"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-right": "hyde-shell volumecontrol -o m",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        }
    },
    "pulseaudio#microphone": {
        "format": " {volume}%",
        "format-muted": " mute",
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-right": "hyde-shell volumecontrol -i m",
        "scroll-step": 5
    },
    "tray": {
        "icon-size": 12,
        "spacing": 10
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "<span color='black'>{status_icon} {dynamic}</span>",
        "max-length": 55,
        "interval": 1,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶"
        },
        "ignored-players": ["firefox", "chromium", "brave"]
    }
}
