{
    // "hancore-monochrome" — adapted from HANCORE-linux/waybar-themes config/V2.1c
    // (monochrome, inspired by OldJobobo monochrome-theme). Dropped Omarchy-only
    // modules (custom/omarchy, custom/update, custom/voxtype, idle/notification-
    // silencing indicators, screenrecording indicator, wttrbar weather,
    // power-profiles-daemon, pacman-updates AUR module) in favor of HyDE
    // equivalents. The tray-expander drawer group and its custom/expand-icon
    // are plain text/format — no external script needed.
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "spacing": 0,
    "height": 27,
    "margin-top": 2,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": [
        "custom/hyde-menu",
        "hyprland/workspaces",
        "idle_inhibitor",
        "group/tray-expander",
        "mpris"
    ],
    "modules-center": ["clock", "custom/updates"],
    "modules-right": [
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "memory",
        "cpu",
        "battery",
        "custom/power"
    ],
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item"
        },
        "modules": ["custom/expand-icon", "tray", "bluetooth", "backlight"]
    },
    "custom/expand-icon": {
        "format": " ",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "cursor": true,
        "format": "{icon}",
        "format-icons": {
            "default": "󱗼",
            "active": "󱗾",
            "empty": "󱗽",
            "focused": "󱥸"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾫"
        }
    },
    "cpu": {
        "interval": 10,
        "format": "  {usage}%",
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "  {used:0.1f}G",
        "on-click": "kitty -e btop"
    },
    "backlight": {
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "hyde-shell brightnesscontrol i 5",
        "on-scroll-down": "hyde-shell brightnesscontrol d 5"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%H:%M %d/%m/%Y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "kitty -e nmtui"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}",
        "format-plugged": " {capacity}%",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "format-full": "󰂅 {capacity}%",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Devices connected: {num_connections}"
    },
    "pulseaudio": {
        "format": "{icon}",
        "tooltip-format": "{icon}  {volume}%",
        "format-muted": " off",
        "format-icons": {
            "default": [""]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-right": "hyde-shell volumecontrol -o m"
    },
    "pulseaudio#microphone": {
        "format-source": "",
        "format-source-muted": " ",
        "format": "{format_source}",
        "tooltip-format": "{format_source} {source_volume}%",
        "scroll-step": 1,
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-right": "hyde-shell volumecontrol -i m"
    },
    "mpris": {
        "format": "󰋎  {artist} - {title}",
        "format-paused": "<i><span color='grey'>{status_icon} {artist}</span></i>",
        "tooltip-format": "{album}",
        "max-length": 35,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "󰋐 "
        },
        "ignored-players": ["firefox", "chromium", "brave"]
    },
    "tray": {
        "icon-size": 11,
        "spacing": 5,
        "cursor": true,
        "show-passive-items": true
    }
}
