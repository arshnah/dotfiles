{
    // Minimal flat layout — same modules as hyprdots/02, no pill grouping
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": [
        "cpu",
        "memory",
        "idle_inhibitor",
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "backlight",
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "privacy",
        "tray",
        "battery",
        "custom/hyde-menu",
        "custom/power"
    ],
    // includes.json gets auto-regenerated (wiping edits there), so the
    // bigger tray/privacy icon sizes live here instead.
    "tray": {
        "icon-size": 15,
        "icon-size-multiplier": 1.2
    },
    "privacy": {
        "icon-size": 11,
        "icon-size-multiplier": 1
    },
    "hyprland/window": {
        "format": "{class}",
        "max-length": 24,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 13
    }
}
