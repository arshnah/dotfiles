{
    // "hancore-rosepine" — adapted from HANCORE-linux/waybar-themes config/V2.1.
    // Grouped modules (group/left*, group/right*) preserved from source. Dropped
    // Omarchy-only modules (custom/omarchy, custom/update, custom/voxtype,
    // idle/notification-silencing indicators, screenrecording indicator,
    // wttrbar weather, pacman-updates AUR module) in favor of HyDE equivalents.
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "height": 24,
    "margin-top": 3,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "group/left1": {
        "orientation": "inherit",
        "modules": ["custom/hyde-menu", "clock"]
    },
    "group/left2": {
        "orientation": "inherit",
        "modules": ["hyprland/workspaces"]
    },
    "group/left3": {
        "orientation": "inherit",
        "modules": ["idle_inhibitor", "custom/updates"]
    },
    "group/left4": {
        "orientation": "inherit",
        "modules": ["mpris"]
    },
    "modules-left": ["group/left1", "group/left2", "group/left3", "group/left4"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["group/right1", "group/right2"],
    "group/right1": {
        "orientation": "inherit",
        "modules": ["tray"]
    },
    "group/right2": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "bluetooth",
            "pulseaudio",
            "pulseaudio#microphone",
            "network",
            "memory",
            "cpu",
            "battery"
        ]
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6]
        }
    },
    "hyprland/window": {
        "format": "{title} - {class}",
        "max-length": 85,
        "separate-outputs": true
    },
    "cpu": {
        "interval": 2,
        "format": "{usage}% 󰍛",
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "  {percentage}%",
        "on-click": "kitty -e btop"
    },
    "clock": {
        "format": " {:%H:%M %a} ",
        "format-alt": " {:%d/%m/%Y  %H:%M:%S}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾫"
        }
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "on-click": "kitty -e nmtui"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "",
        "tooltip-format": "Devices connected: {num_connections}"
    },
    "backlight": {
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
        "on-scroll-up": "hyde-shell brightnesscontrol i 5",
        "on-scroll-down": "hyde-shell brightnesscontrol d 5"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-right": "hyde-shell volumecontrol -o m",
        "tooltip-format": "{icon}  {volume}%",
        "scroll-step": 2,
        "format-muted": " off",
        "format-icons": {
            "default": [""]
        }
    },
    "pulseaudio#microphone": {
        "format": " {volume}%",
        "format-muted": " mute",
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-right": "hyde-shell volumecontrol -i m",
        "scroll-step": 1
    },
    "tray": {
        "icon-size": 12,
        "spacing": 10
    },
    "mpris": {
        "format": "󰋎 {artist} - {title}",
        "format-paused": "<i>{status_icon} {artist}</i>",
        "max-length": 20,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "󰋐"
        },
        "ignored-players": ["firefox", "chromium", "brave"]
    }
}
